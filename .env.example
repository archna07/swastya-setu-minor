# Swastya Setu – Environment Configuration Template
# Duplicate this file as .env in your root directory and adjust values for your environment.

# Application Environment (development | production)
APP_ENV=development
APP_DEBUG=true

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=swastya_setu
DB_USER=root
DB_PASS=1234

# Flask AI Microservice Endpoint
AI_SERVICE_URL=http://127.0.0.1:5000

# Base URL override (optional, defaults to automatic detection)
# BASE_URL=https://swastyasetu.example.com

# Session Configuration
SESSION_LIFETIME=1800

